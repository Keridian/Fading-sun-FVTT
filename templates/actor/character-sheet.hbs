<div class="sheet-scroll">
  <header class="sheet-header">
    <img class="actor-portrait" src="{{actor.img}}" alt="{{actor.name}}">
    <div class="header-fields">
      <input
        class="actor-name"
        type="text"
        name="name"
        value="{{actor.name}}"
        {{#unless editable}}disabled{{/unless}}
      >
      <div class="identity-grid">
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.speciesLabel"}}</span>
          <input type="text" name="system.identity.speciesLabel" value="{{system.identity.speciesLabel}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.rank"}}</span>
          <input type="text" name="system.identity.rank" value="{{system.identity.rank}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.planet"}}</span>
          <input type="text" name="system.identity.planet" value="{{system.identity.planet}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.birthdate"}}</span>
          <input type="text" name="system.identity.birthdate" value="{{system.identity.birthdate}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.advancement.level"}}</span>
          <input type="number" name="system.advancement.level" value="{{system.advancement.level}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.size"}}</span>
          <input type="number" name="system.identity.size" value="{{system.identity.size}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          <span>{{localize "FADING_SUNS_4E.Fields.identity.speed"}}</span>
          <input type="number" name="system.identity.speed" value="{{system.identity.speed}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
        </label>
      </div>
    </div>
  </header>

  <section class="sheet-section resources-section">
    <h2>{{localize "FADING_SUNS.Sheet.Sections.Resources"}}</h2>
    <div class="resource-grid">
      <article class="resource-card vitality-card">
        <h3>{{localize "FADING_SUNS.Sheet.Resources.Vitality"}}</h3>
        <div class="paired-values">
          <label>
            <span>{{localize "FADING_SUNS.Sheet.Resources.Value"}}</span>
            <input type="number" name="system.resources.vitality.value" value="{{system.resources.vitality.value}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
          </label>
          <span class="value-separator">/</span>
          <label>
            <span>{{localize "FADING_SUNS.Sheet.Resources.Max"}}</span>
            <input type="number" value="{{system.resources.vitality.max}}" readonly tabindex="-1">
          </label>
        </div>
      </article>

      <article class="resource-card bank-card">
        <h3>{{localize "FADING_SUNS.Sheet.Resources.Bank"}}</h3>
        <div class="resource-fields bank-fields">
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.VP"}}</span><input type="number" name="system.resources.bank.vp" value="{{system.resources.bank.vp}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.WP"}}</span><input type="number" name="system.resources.bank.wp" value="{{system.resources.bank.wp}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Capacity"}}</span><input type="number" value="{{system.resources.bank.capacity}}" readonly tabindex="-1"></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Used"}}</span><input type="number" value="{{system.resources.bank.used}}" readonly tabindex="-1"></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Available"}}</span><input type="number" value="{{system.resources.bank.available}}" readonly tabindex="-1"></label>
        </div>
      </article>

      <article class="resource-card">
        <h3>{{localize "FADING_SUNS.Sheet.Resources.Cache"}}</h3>
        <div class="resource-fields">
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.VP"}}</span><input type="number" name="system.resources.cache.vp" value="{{system.resources.cache.vp}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.WP"}}</span><input type="number" name="system.resources.cache.wp" value="{{system.resources.cache.wp}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </article>

      <article class="resource-card">
        <h3>{{localize "FADING_SUNS.Sheet.Resources.Surge"}}</h3>
        <div class="resource-fields">
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Rating"}}</span><input type="number" value="{{system.resources.surge.rating}}" readonly tabindex="-1"></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Current"}}</span><input type="number" name="system.resources.surge.current" value="{{system.resources.surge.current}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Max"}}</span><input type="number" value="{{system.resources.surge.max}}" readonly tabindex="-1"></label>
        </div>
      </article>

      <article class="resource-card">
        <h3>{{localize "FADING_SUNS.Sheet.Resources.Revival"}}</h3>
        <div class="resource-fields">
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Rating"}}</span><input type="number" value="{{system.resources.revival.rating}}" readonly tabindex="-1"></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Current"}}</span><input type="number" name="system.resources.revival.current" value="{{system.resources.revival.current}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS.Sheet.Resources.Max"}}</span><input type="number" value="{{system.resources.revival.max}}" readonly tabindex="-1"></label>
        </div>
      </article>
    </div>
  </section>

  <div class="sheet-columns">
    <div class="primary-column">
      <section class="sheet-section">
        <h2>{{localize "FADING_SUNS.Sheet.Sections.Characteristics"}}</h2>
        <div class="characteristic-groups">
          {{#each characteristicGroups}}
            <fieldset class="characteristic-group">
              <legend>{{localize label}}</legend>
              {{#each characteristics}}
                <label>
                  <span>{{localize label}}</span>
                  <input type="number" name="{{path}}" value="{{value}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}>
                </label>
              {{/each}}
            </fieldset>
          {{/each}}
        </div>
      </section>

      <section class="sheet-section">
        <h2>{{localize "FADING_SUNS.Sheet.Sections.Skills"}}</h2>
        <div class="skills-grid">
          {{#each skills}}
            <div class="skill-row">
              <button
                type="button"
                class="skill-roll-button"
                data-action="rollSkill"
                data-skill-key="{{key}}"
                title="{{localize "FADING_SUNS.Roll.RollSkill"}}"
                {{#unless @root.editable}}disabled{{/unless}}
              >{{localize label}}</button>
              <input type="number" name="{{path}}" value="{{value}}" min="0" step="1" aria-label="{{localize label}}" {{#unless @root.editable}}disabled{{/unless}}>
            </div>
          {{/each}}
        </div>
      </section>
    </div>

    <aside class="secondary-column">
      <section class="sheet-section">
        <h2>{{localize "FADING_SUNS.Sheet.Sections.Resistances"}}</h2>
        <div class="resistance-list">
          {{#each resistances}}
            <article>
              <h3>{{localize label}}</h3>
              <div class="paired-values">
                <label>
                  <span>{{localize "FADING_SUNS.Sheet.Resistances.Manual"}}</span>
                  <input type="number" name="{{manualPath}}" value="{{manual}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}>
                </label>
                <label>
                  <span>{{localize "FADING_SUNS.Sheet.Resistances.Total"}}</span>
                  <input type="number" value="{{total}}" readonly tabindex="-1">
                </label>
              </div>
            </article>
          {{/each}}
        </div>
      </section>

      <section class="sheet-section">
        <h2>{{localize "FADING_SUNS.Sheet.Sections.Occult"}}</h2>
        <div class="occult-grid">
          <label><span>{{localize "FADING_SUNS_4E.Fields.occult.psi"}}</span><input type="number" name="system.occult.psi" value="{{system.occult.psi}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS_4E.Fields.occult.urge"}}</span><input type="number" name="system.occult.urge" value="{{system.occult.urge}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS_4E.Fields.occult.theurgy"}}</span><input type="number" name="system.occult.theurgy" value="{{system.occult.theurgy}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
          <label><span>{{localize "FADING_SUNS_4E.Fields.occult.hubris"}}</span><input type="number" name="system.occult.hubris" value="{{system.occult.hubris}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </section>
    </aside>
  </div>

  <section class="sheet-section items-section">
    <h2>{{localize "FADING_SUNS.Sheet.Sections.Items"}}</h2>
    <div class="item-groups">
      {{#each itemGroups}}
        <section class="item-group" data-group="{{key}}">
          <h3>{{localize label}}</h3>
          <ol class="item-list">
            {{#each items}}
              <li class="item-row draggable" data-item-id="{{id}}">
                <img class="item-image" src="{{img}}" alt="{{name}}">
                <div class="item-main">
                  <strong>{{name}}</strong>
                  <span class="item-type">{{typeLabel}}</span>
                  {{#if details.length}}
                    <div class="item-details">
                      {{#each details}}
                        <span><b>{{localize label}}:</b> {{value}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
                {{#if @root.editable}}
                  <div class="item-actions">
                    {{#if isRangedWeapon}}<button type="button" data-action="fireWeapon">{{localize "FADING_SUNS.Roll.Weapon.Fire"}}</button>{{/if}}
                    <button type="button" data-action="editItem">{{localize "FADING_SUNS.Sheet.Actions.Edit"}}</button>
                    <button type="button" data-action="deleteItem">{{localize "FADING_SUNS.Sheet.Actions.Delete"}}</button>
                  </div>
                {{/if}}
              </li>
            {{else}}
              <li class="empty-list">{{localize "FADING_SUNS.Sheet.Items.None"}}</li>
            {{/each}}
          </ol>
        </section>
      {{/each}}
    </div>
  </section>
</div>
